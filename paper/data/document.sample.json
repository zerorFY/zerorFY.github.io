          "language_variants": {
            "en": {
              "title": "Structured text",
              "text_content": "The paper learning system first splits a source document into stable sections and segments, so notes, questions, and model results can anchor to a concrete segment in a concrete version."
            },
            "zh": {
              "title": "结构化正文",
              "text_content": "论文学习系统首先把源文档拆成稳定的章节和段落单元，让批注、问题和模型结果都能锚定到某个具体版本里的具体 Segment。"
            }
          }
        },
        {
