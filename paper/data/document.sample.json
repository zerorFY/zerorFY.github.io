          },
          "language_variants": {
            "en": {
              "title": "Worker role",
              "text_content": "The Worker does not own core business logic. It claims tasks, prepares context, calls a model, preserves raw output, validates structured results, and writes results back through shared contracts."
            },
            "zh": {
              "title": "Worker 角色",
              "text_content": "Worker 不拥有核心业务逻辑。它只负责领取任务、准备上下文、调用模型、保留原始输出、校验结构化结果，并通过共享契约回写结果。"
            }
          }
        }
